FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /server .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/* && useradd -u 10001 -m app && mkdir /data && chown app:app /data
COPY --from=build /server /usr/local/bin/chadkrishi
USER app
WORKDIR /data
ENV UPLOAD_DIR=/data/uploads
EXPOSE 8080
ENTRYPOINT ["chadkrishi"]
