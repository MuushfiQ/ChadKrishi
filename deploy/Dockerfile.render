FROM node:22-bookworm-slim AS web-build
WORKDIR /src
COPY package*.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM golang:1.26-bookworm AS api-build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /server .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/* && useradd -u 10001 -m app && mkdir -p /app/dist /data && chown -R app:app /app /data
COPY --from=api-build /server /usr/local/bin/chadkrishi
COPY --from=web-build /src/dist /app/dist
USER app
WORKDIR /data
ENV STATIC_DIR=/app/dist
ENV UPLOAD_DIR=/data/uploads
EXPOSE 10000
ENTRYPOINT ["chadkrishi"]
